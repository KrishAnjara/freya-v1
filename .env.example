# Primary provider: ollama, groq, gemini, or hybrid
#   hybrid: the local Ollama model writes every reply; a cloud model (FREYA_BRIEF_PROVIDER)
#   first reads the question and hands back facts, terminology, and a judgment of hostile or
#   disputed turns, then stands in as fallback if Ollama is down. Sends each message to the
#   cloud for that brief; privacy mode still keeps everything local.
AI_PROVIDER=groq
AI_FALLBACK_ENABLED=true
# Optional explicit fallback target. For local-first operation, set AI_PROVIDER=ollama
# and AI_FALLBACK_PROVIDER=groq (or gemini). External fallback shares conversation data.
AI_FALLBACK_PROVIDER=groq
# Which cloud model writes the hybrid brief: groq (fast) or gemini.
# FREYA_BRIEF_PROVIDER=groq
# Output ceiling per request; longer replies are continued automatically, up to the limit.
# AI_MAX_OUTPUT_TOKENS=1400
# AI_MAX_CONTINUATIONS=4

# Self-hosted: one owner running FREYA on their own machine with their own keys. Replaces
# per-visitor identity (which needs FREYA_TRUSTED_IP_HEADER from a hosting edge) with a single
# owner rate-limit budget, and lets a single process limit locally without Upstash. Use with
# `npm run start:local`, which binds to 127.0.0.1. Never enable this on a public deployment.
# Best set in .env.local, which overrides .env on that machine only.
# FREYA_SELF_HOSTED=true

# Ollama local inference. Install Ollama separately, then optionally pull one model:
#   ollama pull qwen2.5:3b      (good balance on a laptop CPU)
# Then build FREYA's persona on top of it with `npm run ollama:create` (see ollama/Modelfile)
# and set OLLAMA_MODEL=freya. A 1B model is too small to hold the persona reliably.
# No model is downloaded automatically. Keep the endpoint loopback-only unless you
# have separately secured the Ollama host.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=4096

# Optional separate FastAPI orchestration service. Leave FREYA_SERVICE_URL empty
# to use the current in-process Next.js provider path. When configured, use a
# random secret of at least 32 characters in both server environments.
# FREYA_SERVICE_URL=http://127.0.0.1:8000
# FREYA_SERVICE_TOKEN=generate-a-random-32-character-or-longer-secret
# FREYA_PROVIDER_TIMEOUT_SECONDS=25
# FREYA_MAX_CONCURRENCY=4
# FREYA_REASONING_PROVIDER=gemini
# FREYA_SUMMARY_PROVIDER=ollama
FREYA_REFLECTION_ENABLED=true
FREYA_REFLECTION_DAILY_LIMIT=1

# Required in production for shared serverless rate limiting. Keep the token server-side.
# Development/tests use an explicitly local, non-distributed fallback.
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me
# Set this on the production host to the header written by its trusted edge:
# x-vercel-forwarded-for, cf-connecting-ip, or x-real-ip. Do not use generic x-forwarded-for.
FREYA_TRUSTED_IP_HEADER=x-vercel-forwarded-for

# Groq: https://console.groq.com/keys
GROQ_API_KEY=replace_me
GROQ_MODEL=qwen/qwen3.8-27b
# Qwen 3.8 supports none, low, medium, high. "none" is recommended for fast casual chat.
GROQ_REASONING_EFFORT=none

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash

# Uses Gemini Google Search grounding when a question likely needs current or verifiable facts.
# This consumes Gemini quota even when Groq is the primary chat model.
WEB_SEARCH_ENABLED=false
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Optional fallback web search provider (used if Gemini grounding is unavailable).
TAVILY_API_KEY=replace_me

# Optional: enable authenticated cross-device cloud memory.
# Create a project at https://supabase.com and run supabase/schema.sql in SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
