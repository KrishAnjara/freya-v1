# FREYA configuration. `npm run setup` copies this to .env.local (git-ignored) for you.
# Fill in what you have; everything except one chat provider key is optional.
# Secrets stay empty here on purpose: an empty value means "not configured" everywhere.

# --- Chat providers (at least one key) ---------------------------------------------------
# Groq: https://console.groq.com/keys   (recommended: fast, and runs the reasoning analyst)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none
# Gemini: https://aistudio.google.com/apikey   (vision, voice-note listening, second analyst)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# xAI Grok: https://console.x.ai   Does the logic work (reasoning panel, briefs, memory,
# visualisation) when set; blank, or when it fails, those jobs stay on Groq. It never writes
# replies, and Groq still handles voice transcription.
XAI_API_KEY=
# XAI_MODEL=grok-4.7
# XAI_REASONING_EFFORT=low              low | medium | high (slower, and it holds up the reply)

# Who writes replies: groq, gemini, ollama, server, or hybrid.
# hybrid (recommended with Ollama): the "freya" model is the voice for every reply; Grok
# (Groq with no xAI key) reasons and researches, Gemini handles live facts, images and voice notes, and their notes are
# handed to it. On a laptop CPU each reply takes ~20-60 s and the model is small. To run it on a GPU
# elsewhere, see "Her model on a server" below.
# server: any OpenAI-compatible server is the voice (VOICE_* below).
# groq: cloud replies (fast), for machines without Ollama. The fallback answers only when the
# primary fails (in hybrid: when the local model is unreachable).
AI_PROVIDER=groq
# --- Her model on a server ---------------------------------------------------------------
# `start.bat --remote URL --key KEY` writes these into .env.local for you; `--local` removes them.
# training/freya_server.ipynb starts a server on Colab and prints that line.
# OLLAMA_BASE_URL=https://your-server    an Ollama server
# OLLAMA_API_KEY=                        its token, sent as a Bearer header
# OLLAMA_NUM_CTX=8192                    context window (4096 on this machine, 8192 on a server)
# OLLAMA_THINK=true                      hidden thinking, which helps on a GPU
# VOICE_BASE_URL=https://your-server/v1  or an OpenAI-compatible one (with AI_PROVIDER=server)
# VOICE_API_KEY=
# VOICE_MODEL=
# VOICE_STREAM=false                     if replies only arrive whole (automatic on quick tunnels)

# Background jobs (server-owned; requests cannot change them):
# FREYA_REASONING_MODE=auto             auto | always | off for the reasoning panel
# FREYA_MEMORY_MODEL=openai/gpt-oss-120b automatic memory
# FREYA_VISUALIZE_MODEL=openai/gpt-oss-120b /visualize
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image /image (needs a key with image quota)
# FREYA_IMAGE_GENERATION=true           false: always draw SVGs instead
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDER=gemini
# AI_MAX_OUTPUT_TOKENS=1400
# AI_MAX_CONTINUATIONS=4

# --- Reasoning panel (lib/council) --------------------------------------------------------
# For maths, code, logic and decisions, Grok (Groq's reasoning model with no key) and Gemini each solve the
# question independently before FREYA answers. Users can set Auto/Always/Off in Settings.
FREYA_REASONING_MODEL=openai/gpt-oss-120b
# low, medium or high: higher is more careful and slower.
FREYA_REASONING_EFFORT=medium

# --- Web search ---------------------------------------------------------------------------
# Tavily: https://app.tavily.com   (Gemini search grounding is also used when available)
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
GEMINI_SEARCH_MODEL=gemini-3.8-flash

# --- Local model (Ollama) -----------------------------------------------------------------
# Install Ollama from https://ollama.com/download, then `npm run ollama:create` builds the
# "freya" model (Qwen3.5 4B, ~3.4 GB download the first time). Keep Ollama loopback-only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=freya
OLLAMA_NUM_CTX=4096
# Hidden "thinking" before replies. Off: on a CPU it adds minutes per reply.
OLLAMA_THINK=false

# --- Voice ----------------------------------------------------------------------------------
# Voice messages are transcribed with Groq Whisper (uses GROQ_API_KEY).
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# --- Running on your own machine ----------------------------------------------------------
# One owner, own keys: a single owner rate-limit budget and no Upstash needed. Use with
# `npm run start:local` (binds to 127.0.0.1). Never enable this on a public deployment.
# FREYA_SELF_HOSTED=true

# --- Public deployment only -----------------------------------------------------------------
# Shared rate limiting (required in production unless self-hosted): https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Header your hosting edge writes with the client IP: x-vercel-forwarded-for, cf-connecting-ip
# or x-real-ip. Never generic x-forwarded-for.
FREYA_TRUSTED_IP_HEADER=
# Protects GET /api/health in production (24+ random characters).
FREYA_HEALTH_TOKEN=

# --- Optional extras ------------------------------------------------------------------------
# Cross-device memory: create a Supabase project and run supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
FREYA_REFLECTION_ENABLED=true
FREYA_REFLECTION_DAILY_LIMIT=1
# Separate Python orchestration service (freya_service/). Leave empty to skip it.
# FREYA_SERVICE_URL=http://127.0.0.1:8000
# FREYA_SERVICE_TOKEN=a-random-secret-of-at-least-32-characters
