# FREYA configuration. `npm run setup` copies this to .env.local (git-ignored) for you.
# Fill in what you have; everything except one chat provider key is optional.
# Secrets stay empty here on purpose: an empty value means "not configured" everywhere.

# --- Chat providers (at least one key) ---------------------------------------------------
# Groq: https://console.groq.com/keys   (recommended: fast, and runs the reasoning analyst)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none
# Gemini: https://aistudio.google.com/apikey   (vision, voice-note listening, second analyst)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Who writes replies: groq, gemini, ollama, or hybrid (local model writes, cloud researches).
AI_PROVIDER=groq
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDER=gemini
# AI_MAX_OUTPUT_TOKENS=1400
# AI_MAX_CONTINUATIONS=4

# --- Reasoning panel (lib/council) --------------------------------------------------------
# For maths, code, logic and decisions, Groq's reasoning model and Gemini each solve the
# question independently before FREYA answers. Users can set Auto/Always/Off in Settings.
FREYA_REASONING_MODEL=openai/gpt-oss-120b
# low, medium or high: higher is more careful and slower.
FREYA_REASONING_EFFORT=medium

# --- Web search ---------------------------------------------------------------------------
# Tavily: https://app.tavily.com   (Gemini search grounding is also used when available)
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# --- Local model (Ollama) -----------------------------------------------------------------
# Install Ollama from https://ollama.com/download, then `npm run ollama:create` builds the
# "freya" model (Qwen3.5 4B, ~3.4 GB download the first time). Keep Ollama loopback-only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=freya
OLLAMA_NUM_CTX=4096
# Hidden "thinking" before replies. Off: on a CPU it adds minutes per reply.
OLLAMA_THINK=false

# --- Voice ----------------------------------------------------------------------------------
# Voice messages are transcribed with Groq Whisper (uses GROQ_API_KEY).
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# --- Running on your own machine ----------------------------------------------------------
# One owner, own keys: a single owner rate-limit budget and no Upstash needed. Use with
# `npm run start:local` (binds to 127.0.0.1). Never enable this on a public deployment.
# FREYA_SELF_HOSTED=true

# --- Public deployment only -----------------------------------------------------------------
# Shared rate limiting (required in production unless self-hosted): https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Header your hosting edge writes with the client IP: x-vercel-forwarded-for, cf-connecting-ip
# or x-real-ip. Never generic x-forwarded-for.
FREYA_TRUSTED_IP_HEADER=
# Protects GET /api/health in production (24+ random characters).
FREYA_HEALTH_TOKEN=

# --- Optional extras ------------------------------------------------------------------------
# Cross-device memory: create a Supabase project and run supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
FREYA_REFLECTION_ENABLED=true
FREYA_REFLECTION_DAILY_LIMIT=1
# Separate Python orchestration service (freya_service/). Leave empty to skip it.
# FREYA_SERVICE_URL=http://127.0.0.1:8000
# FREYA_SERVICE_TOKEN=a-random-secret-of-at-least-32-characters
